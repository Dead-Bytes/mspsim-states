<project name="MSPSim" default="jar" basedir=".">
  <description>
     Builds MSPSim
  </description>

  <property name="src" location="."/>
  <property name="build" location="build"/>
  <property name="lib" location="lib"/>
  <property name="jarfile" location="mspsim.jar"/>
  <property name="javac.debug" value="true"/>
  <property name="ant.build.javac.source" value="11"/>
  <property name="ant.build.javac.target" value="11"/>
  <property name="ARGS" value=""/>

  <!-- Energy monitoring configuration properties -->
  <!-- Realistic IoT battery: 20 Joules = 20,000,000,000 nJ (small capacity for testing) -->
  <property name="TOTAL_ENERGY_NJ" value="20000.0"/>
  <property name="ENERGY_MODEL_FILE" value="blocks_with_real_energy.json"/>
  <property name="ENERGY_LOGGING" value="true"/>
  <property name="ENERGY_CHECKPOINT_THRESHOLD" value="20.0"/>
  <property name="STRATEGY" value="adaptive"/>

  <!-- Energy harvesting configuration properties -->
  <!-- Settings for DEFICIT scenario: harvesting < consumption (90% of time) -->
  <!-- Tiny 0.05 cm² panel, 12% efficiency, very low 20 W/m² light = ~1 nJ/ms harvest rate -->
  <property name="ENERGY_HARVESTING_ENABLED" value="true"/>
  <property name="HARVESTER_PANEL_AREA_CM2" value="0.1"/>
  <property name="HARVESTER_PANEL_EFFICIENCY" value="12"/>
  <property name="HARVESTER_IRRADIANCE_WM2" value="20.0"/>
  <property name="HARVESTER_PROFILE" value="realistic"/>

  <!-- Adaptive checkpointing configuration -->
  <property name="CHECKPOINTING_ENABLED" value="true"/>

  <path id="classpath">
    <fileset dir="${lib}" includes="**/*.jar"/>
  </path>

  <manifestclasspath property="jar.classpath" jarfile="${jarfile}">
    <classpath refid="classpath" />
  </manifestclasspath>

  <target name="init">
    <tstamp/>
    <mkdir dir="${build}"/>
  </target>

  <target name="compile" depends="init" description="compile the source">
    <javac srcdir="${src}" destdir="${build}" classpathref="classpath"
           debug="${javac.debug}" includeantruntime="false" encoding="utf-8">
      <compilerarg value="-Xlint:unchecked"/>
      <compilerarg value="-deprecation"/>
      <exclude name="tests/**" />
    </javac>
  </target>

  <target name="jar" depends="compile" description="generate MSPSim jar file" >
    <jar jarfile="${jarfile}" basedir="${build}">
      <manifest>
        <attribute name="Main-Class" value="se.sics.mspsim.Main"/>
      	<attribute name="Sealed" value="true"/>
      	<attribute name="Class-Path" value="${jar.classpath}" />
      </manifest>
      <fileset dir="." includes="images/*.jpg,images/*.png"/>
    </jar>
  </target>

  <target name="runesb" depends="jar" description="run MSPSim with platform ESB">
    <property name="FIRMWAREFILE" value="firmware/esb/sensor-demo.esb"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.esb.ESBNode">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="rundjikstra" depends="jar" description="run MSPSim with platform Sky and energy monitoring">
    <property name="FIRMWAREFILE" value="benchmarks/djikstra.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runcuckoo" depends="jar" description="run MSPSim with platform Sky and energy monitoring">
    <property name="FIRMWAREFILE" value="benchmarks/cuckoo.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runsort" depends="jar" description="run MSPSim with platform Sky and energy monitoring (GUI)">
    <property name="FIRMWAREFILE" value="benchmarks/sort.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <env key="ENERGY_HARVESTING_ENABLED" value="${ENERGY_HARVESTING_ENABLED}"/>
      <env key="HARVESTER_PANEL_AREA_CM2" value="${HARVESTER_PANEL_AREA_CM2}"/>
      <env key="HARVESTER_PANEL_EFFICIENCY" value="${HARVESTER_PANEL_EFFICIENCY}"/>
      <env key="HARVESTER_IRRADIANCE_WM2" value="${HARVESTER_IRRADIANCE_WM2}"/>
      <env key="HARVESTER_PROFILE" value="${HARVESTER_PROFILE}"/>
      <env key="CHECKPOINTING_ENABLED" value="${CHECKPOINTING_ENABLED}"/>
      <jvmarg value="-Djava.awt.headless=false"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runsort-headless" depends="jar" description="run MSPSim with platform Sky and energy monitoring (no GUI)">
    <property name="FIRMWAREFILE" value="benchmarks/sort.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runrsa" depends="jar" description="run MSPSim with platform Sky and energy monitoring">
    <property name="FIRMWAREFILE" value="benchmarks/rsa.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runsha" depends="jar" description="run MSPSim with platform Sky and energy monitoring">
    <property name="FIRMWAREFILE" value="benchmarks/sha.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runskyprof" depends="jar" description="run MSPSim with platform Sky for profiling">
    <property name="FIRMWAREFILE" value="firmware/sky/blink.sky"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <jvmarg value="-agentlib:yjpagent" />
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runtelos" depends="jar" description="run MSPSim with platform Telos">
    <property name="FIRMWAREFILE" value="firmware/sky/blink.sky"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.TelosNode">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runjcreate" depends="jar" description="run MSPSim with platform Sentilla JCreate">
    <property name="FIRMWAREFILE" value="firmware/sky/blink.sky"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.jcreate.JCreateNode">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runsentillausb" depends="jar" description="run MSPSim with platform Sentilla Gateway USB">
    <property name="FIRMWAREFILE" value="firmware/sky/blink.sky"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sentillausb.SentillaUSBNode">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runz1" depends="jar" description="run MSPSim with platform Zolertia Z1">
    <property name="FIRMWAREFILE" value="firmware/z1/blink.z1"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.z1.Z1Node">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runwismote" depends="jar" description="run MSPSim with platform Wismote">
    <property name="FIRMWAREFILE" value="firmware/wismote/blink.wismote"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.wismote.WismoteNode">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runtyndall" depends="jar" description="run MSPSim with platform Tyndall">
    <property name="FIRMWAREFILE" value="firmware/tyndall/blink.tyndall"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.tyndall.TyndallNode">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="runexp5438" depends="jar" description="run MSPSim with platform exp5438">
    <property name="FIRMWAREFILE" value="firmware/exp5438/tesetcase-bits.exp5438"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.ti.Exp5438">
      <arg value="${FIRMWAREFILE}"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="run" depends="jar" description="run MSPSim">
    <property name="FIRMWAREFILE" value="firmware/sky/blink.sky"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.Main">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWAREFILE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <target name="test-cpu" depends="jar" description="run MSPSim CPU test">
    <java fork="true" classpath="${jarfile}"
          classname="se.sics.mspsim.util.Test"
          failonerror="true"
          timeout="10000">
      <arg value="firmware/sky/cputest.sky"/>
    </java>
  </target>

  <target name="test-timer" depends="jar" description="run MSPSim Timer test">
    <java fork="true" classpath="${jarfile}"
          classname="se.sics.mspsim.util.Test"
          failonerror="true"
          timeout="10000">
      <arg value="firmware/sky/timertest.sky"/>
    </java>
  </target>

  <target name="test" depends="jar, test-cpu, test-timer"/>

  <!-- Generic energy-enabled target for custom firmware and energy profiles -->
  <target name="run-with-energy" depends="jar" description="run MSPSim with custom firmware and energy profile">
    <fail unless="FIRMWARE" message="Please specify firmware file: ant run-with-energy -DFIRMWARE=path/to/firmware.ihex"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
      <env key="ENERGY_MODEL_FILE" value="${ENERGY_MODEL_FILE}"/>
      <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
      <env key="STRATEGY" value="${STRATEGY}"/>
      <arg value="${FIRMWARE}"/>
      <arg value="nogui"/>
      <arg line="${ARGS}"/>
    </java>
  </target>

  <!-- Energy profile testing targets -->
  <target name="test-energy-sort" depends="jar" description="test sort with specific energy profile">
    <property name="TEST_ENERGY_FILE" value="${ENERGY_MODEL_FILE}"/>
    <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
      <env key="TOTAL_ENERGY_NJ" value="10000.0"/>
      <env key="ENERGY_MODEL_FILE" value="${TEST_ENERGY_FILE}"/>
      <env key="ENERGY_LOGGING" value="true"/>
      <env key="ENERGY_CHECKPOINT_THRESHOLD" value="25.0"/>
      <env key="STRATEGY" value="jit"/>
      <arg value="benchmarks/sort.ihex"/>
      <arg value="nogui"/>
    </java>
  </target>

  <target name="help-energy" description="show energy configuration options">
    <echo message="=== MSPSim Energy Configuration ==="/>
    <echo message=""/>
    <echo message="Available energy properties:"/>
    <echo message="  -DTOTAL_ENERGY_NJ=value      : Total energy budget in nanojoules (default: ${TOTAL_ENERGY_NJ})"/>
    <echo message="  -DENERGY_MODEL_FILE=path     : Path to JSON energy analysis file (default: ${ENERGY_MODEL_FILE})"/>
    <echo message="  -DENERGY_LOGGING=true/false  : Enable energy logging (default: ${ENERGY_LOGGING})"/>
    <echo message="  -DENERGY_CHECKPOINT_THRESHOLD=value : Battery % for checkpoints (default: ${ENERGY_CHECKPOINT_THRESHOLD})"/>
    <echo message="  -DSTRATEGY=name              : Checkpoint strategy (default: ${STRATEGY})"/>
    <echo message=""/>
    <echo message="Usage examples:"/>
    <echo message="  ant runsort"/>
    <echo message="  ant runsort -DENERGY_MODEL_FILE=my_analysis.json"/>
    <echo message="  ant runsort -DTOTAL_ENERGY_NJ=50000 -DSTRATEGY=periodic"/>
    <echo message="  ant run-with-energy -DFIRMWARE=benchmarks/sort.ihex -DENERGY_MODEL_FILE=blocks_with_real_energy.json"/>
    <echo message="  ant test-energy-sort -DTEST_ENERGY_FILE=custom_energy.json"/>
    <echo message=""/>
    <echo message="Available strategies: jit, periodic, adaptive, proposed"/>
    <echo message=""/>
    <echo message="Output files:"/>
    <echo message="  ./outputs/energy_log_*.csv    : Per-instruction energy consumption"/>
    <echo message="  ./outputs/battery_log_*.csv   : Battery level over time"/>
  </target>

  <!-- ========================================================================= -->
  <!-- ML Model Comparison Testing Targets                                       -->
  <!-- ========================================================================= -->

  <!-- Macro for running a single model test -->
  <macrodef name="run-model-test">
    <attribute name="modelname"/>
    <attribute name="modelfile"/>
    <attribute name="description" default=""/>
    <sequential>
      <echo message="========================================"/>
      <echo message="Testing: @{modelname}"/>
      <echo message="@{description}"/>
      <echo message="========================================"/>
      <java fork="true" classpath="${jarfile}" classname="se.sics.mspsim.platform.sky.SkyNode">
        <env key="TOTAL_ENERGY_NJ" value="${TOTAL_ENERGY_NJ}"/>
        <env key="ENERGY_MODEL_FILE" value="@{modelfile}"/>
        <env key="ENERGY_LOGGING" value="${ENERGY_LOGGING}"/>
        <env key="ENERGY_CHECKPOINT_THRESHOLD" value="${ENERGY_CHECKPOINT_THRESHOLD}"/>
        <env key="STRATEGY" value="${STRATEGY}"/>
        <env key="ENERGY_HARVESTING_ENABLED" value="${ENERGY_HARVESTING_ENABLED}"/>
        <env key="HARVESTER_PANEL_AREA_CM2" value="${HARVESTER_PANEL_AREA_CM2}"/>
        <env key="HARVESTER_PANEL_EFFICIENCY" value="${HARVESTER_PANEL_EFFICIENCY}"/>
        <env key="HARVESTER_IRRADIANCE_WM2" value="${HARVESTER_IRRADIANCE_WM2}"/>
        <env key="HARVESTER_PROFILE" value="${HARVESTER_PROFILE}"/>
        <env key="CHECKPOINTING_ENABLED" value="${CHECKPOINTING_ENABLED}"/>
        <arg value="benchmarks/sort.ihex"/>
        <arg value="nogui"/>
      </java>
      <echo message="✓ @{modelname} test completed"/>
      <echo message=""/>
    </sequential>
  </macrodef>

  <!-- Master target to run all ML model tests -->
  <target name="test-all-ml-models" depends="jar"
          description="Run sort benchmark with all 6 ML energy prediction models">
    <echo message=""/>
    <echo message="╔═══════════════════════════════════════════════════════════════╗"/>
    <echo message="║   ML Energy Prediction Model Comparison Test Suite            ║"/>
    <echo message="║   Running sort.ihex with 6 different energy models            ║"/>
    <echo message="╚═══════════════════════════════════════════════════════════════╝"/>
    <echo message=""/>
    <echo message="Configuration:"/>
    <echo message="  Total Energy Budget: ${TOTAL_ENERGY_NJ} nJ"/>
    <echo message="  Checkpoint Strategy: ${STRATEGY}"/>
    <echo message="  Energy Harvesting: ${ENERGY_HARVESTING_ENABLED}"/>
    <echo message=""/>

    <run-model-test modelname="Original Energy Model"
                    modelfile="blocks_with_real_energy.json"
                    description="Baseline energy model"/>

    <run-model-test modelname="XGBoost Model"
                    modelfile="blocks_with_real_energy_xgboost.json"
                    description="MAPE 7.77%, Best Accuracy"/>

    <run-model-test modelname="Random Forest Model"
                    modelfile="blocks_with_real_energy_randomforest.json"
                    description="MAPE 8.09%, Alternative Accurate"/>

    <run-model-test modelname="Gradient Boosting Model"
                    modelfile="blocks_with_real_energy_gradientboosting.json"
                    description="Safety-Focused, 1.79% Underestimation"/>

    <run-model-test modelname="Quantile Linear Regression"
                    modelfile="blocks_with_real_energy_qlr.json"
                    description="Conservative Baseline"/>

    <run-model-test modelname="Ensemble Model"
                    modelfile="blocks_with_real_energy_ensemble.json"
                    description="Balanced Accuracy + Safety"/>

    <echo message=""/>
    <echo message="╔═══════════════════════════════════════════════════════════════╗"/>
    <echo message="║   All 6 ML Model Tests Completed!                             ║"/>
    <echo message="╚═══════════════════════════════════════════════════════════════╝"/>
    <echo message=""/>
    <echo message="Results saved to: ./outputs/"/>
    <echo message="  - energy_log_*.csv      : Instruction-level energy traces"/>
    <echo message="  - block_log_*.csv       : Block-level energy consumption"/>
    <echo message="  - checkpoint_log_*.csv  : Checkpoint decisions"/>
    <echo message=""/>
    <echo message="Next steps:"/>
    <echo message="  1. Run: python3 outputs/analyze_ml_models.py"/>
    <echo message="  2. Open: outputs/ml_model_comparison.ipynb"/>
    <echo message=""/>
  </target>

  <!-- Individual test targets for convenience -->
  <target name="test-original" depends="jar" description="Test original energy model">
    <run-model-test modelname="Original Energy Model"
                    modelfile="blocks_with_real_energy.json"
                    description="Baseline energy model"/>
  </target>

  <target name="test-xgboost" depends="jar" description="Test XGBoost ML model">
    <run-model-test modelname="XGBoost Model"
                    modelfile="blocks_with_real_energy_xgboost.json"
                    description="MAPE 7.77%, Best Accuracy"/>
  </target>

  <target name="test-randomforest" depends="jar" description="Test Random Forest ML model">
    <run-model-test modelname="Random Forest Model"
                    modelfile="blocks_with_real_energy_randomforest.json"
                    description="MAPE 8.09%, Alternative Accurate"/>
  </target>

  <target name="test-gradientboosting" depends="jar" description="Test Gradient Boosting ML model">
    <run-model-test modelname="Gradient Boosting Model"
                    modelfile="blocks_with_real_energy_gradientboosting.json"
                    description="Safety-Focused, 1.79% Underestimation"/>
  </target>

  <target name="test-qlr" depends="jar" description="Test Quantile Linear Regression model">
    <run-model-test modelname="Quantile Linear Regression"
                    modelfile="blocks_with_real_energy_qlr.json"
                    description="Conservative Baseline"/>
  </target>

  <target name="test-ensemble" depends="jar" description="Test Ensemble ML model">
    <run-model-test modelname="Ensemble Model"
                    modelfile="blocks_with_real_energy_ensemble.json"
                    description="Balanced Accuracy + Safety"/>
  </target>

  <target name="clean" description="clean up" >
    <delete dir="${build}"/>
    <delete file="${jarfile}" />
  </target>

</project>
