# MSPSim Energy Configuration
# Total energy budget in nanojoules
# Based on analysis: ~4µJ per full program execution, set to 20µJ for multiple runs
TOTAL_ENERGY_NJ=20000.0

# Path to JSON file containing instruction-level energy data
ENERGY_MODEL_FILE=blocks_with_real_energy.json

# Enable/disable energy logging to CSV
ENERGY_LOGGING=true

# Battery percentage threshold for low energy warnings and checkpoints
ENERGY_CHECKPOINT_THRESHOLD=20.0

# Existing MSPSim configuration
STRATEGY=adaptive
BATTERY_BASELINE=100.0